                            "defaultConfiguration": {},
                            "fullDescription": {
                                "text": "The app requests a permission that it does not need. Extra permissions increase the attack surface on the device if the app is exploited or abused via another attack vector which could expose data or functionality. It is also a poor development practice to request functionality that is not needed for execution. This can decrease trust from the user and make the app appear more privileged and invasive than it really is."
                            },
                            "shortDescription": {
                                "text": "Requests excessive permissions"
                            }
                        }
                    ],
